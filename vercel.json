{
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/challang-datemap", "destination": "/challang-datemap.html" },
    { "source": "/datemap", "destination": "/challang-datemap.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
